# The shared todo data layer — a plain lib crate the `api` and `feed` components depend
# on (compiled into each; the Rust twin of the TypeScript example's lib/todos.ts).
[package]
name = "todos"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
name = "todos"

[dependencies]
rusm-rs = "0.7.0"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
